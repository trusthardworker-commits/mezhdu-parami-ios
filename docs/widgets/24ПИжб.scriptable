{"name":"Пары 24ПИжб","script":"const group = {\"id\":\"24ПИжб\",\"sourcePage\":2,\"validFrom\":\"2026-11-09\",\"validThrough\":\"2026-12-29\",\"warning\":null,\"lessons\":[{\"id\":\"24ПИжб-1\",\"weekday\":1,\"period\":2,\"week\":\"both\",\"title\":\"Базы данных\",\"details\":\"лк. · Проценко И.Г. · 7-317\"},{\"id\":\"24ПИжб-2\",\"weekday\":1,\"period\":4,\"week\":\"upper\",\"title\":\"ПРИС\",\"details\":\"лб. · Чебанюк С.В. · 7-320\"},{\"id\":\"24ПИжб-3\",\"weekday\":1,\"period\":5,\"week\":\"upper\",\"title\":\"ПРИС\",\"details\":\"лб. · Чебанюк С.В. · 7-320\"},{\"id\":\"24ПИжб-4\",\"weekday\":2,\"period\":3,\"week\":\"both\",\"title\":\"Элективные курсы по ФК и спорту (ОФП)\",\"details\":\"12:00–14:00 · Соколова Т.П. · ФОК, универсальный зал\"},{\"id\":\"24ПИжб-5\",\"weekday\":2,\"period\":4,\"week\":\"both\",\"title\":\"МИМ\",\"details\":\"лк. · Проценко И.Г. · 7-317\"},{\"id\":\"24ПИжб-6\",\"weekday\":2,\"period\":5,\"week\":\"both\",\"title\":\"МИМ\",\"details\":\"лб. · Проценко И.Г. · 7-310\"},{\"id\":\"24ПИжб-7\",\"weekday\":2,\"period\":6,\"week\":\"upper\",\"title\":\"ТА и ФЯ\",\"details\":\"пр. · Бесхмельницына З.А. · 7-513 · с 09.11\",\"startsOn\":\"2026-11-09\"},{\"id\":\"24ПИжб-8\",\"weekday\":2,\"period\":6,\"week\":\"lower\",\"title\":\"ТА и ФЯ\",\"details\":\"лк. · Бесхмельницына З.А. · 7-513 · с 09.11\",\"startsOn\":\"2026-11-09\"},{\"id\":\"24ПИжб-9\",\"weekday\":3,\"period\":1,\"week\":\"upper\",\"title\":\"Р и АТ\",\"details\":\"лк. · Рычка И.А. · 7-317\"},{\"id\":\"24ПИжб-10\",\"weekday\":3,\"period\":1,\"week\":\"lower\",\"title\":\"Проф. английский язык\",\"details\":\"Крючкова И.А. · 7-213\"},{\"id\":\"24ПИжб-11\",\"weekday\":3,\"period\":2,\"week\":\"both\",\"title\":\"Р и АТ\",\"details\":\"лб. · Рычка И.А. · 7-308\"},{\"id\":\"24ПИжб-12\",\"weekday\":3,\"period\":3,\"week\":\"lower\",\"title\":\"ПРИС\",\"details\":\"лб. · Чебанюк С.В. · 7-320\"},{\"id\":\"24ПИжб-13\",\"weekday\":4,\"period\":0,\"week\":\"both\",\"title\":\"Военное обучение\",\"details\":\"Время в документе не указано\"},{\"id\":\"24ПИжб-14\",\"weekday\":5,\"period\":1,\"week\":\"lower\",\"title\":\"Методы оптимизации\",\"details\":\"пр. · Чермошенцева А.А. · 7-510\"},{\"id\":\"24ПИжб-15\",\"weekday\":5,\"period\":2,\"week\":\"both\",\"title\":\"Методы оптимизации\",\"details\":\"лк. · Чермошенцева А.А. · 7-510 · с 23.11\",\"startsOn\":\"2026-11-23\"},{\"id\":\"24ПИжб-16\",\"weekday\":5,\"period\":3,\"week\":\"upper\",\"title\":\"Проф. английский язык\",\"details\":\"Крючкова И.А. · 7-213\"},{\"id\":\"24ПИжб-17\",\"weekday\":5,\"period\":3,\"week\":\"lower\",\"title\":\"ПРИС\",\"details\":\"лк. · Чебанюк С.В. · 7-320\"},{\"id\":\"24ПИжб-18\",\"weekday\":5,\"period\":4,\"week\":\"both\",\"title\":\"ПРИС\",\"details\":\"лб. · Чебанюк С.В. · 7-320 · кроме 06.11 и 04.12\",\"excludedDates\":[\"2026-11-06\",\"2026-12-04\"]},{\"id\":\"24ПИжб-19\",\"weekday\":5,\"period\":5,\"week\":\"upper\",\"title\":\"Элективные курсы по ФКиС\",\"details\":\"Соколова Т.П. · УК-2 СЗ\"},{\"id\":\"24ПИжб-20\",\"weekday\":6,\"period\":1,\"week\":\"both\",\"title\":\"Дискретная математика\",\"details\":\"лк. · Родоманская А.И. · 7-501 · с 09.11\",\"startsOn\":\"2026-11-09\"},{\"id\":\"24ПИжб-21\",\"weekday\":6,\"period\":2,\"week\":\"both\",\"title\":\"Дискретная математика\",\"details\":\"лк. · Родоманская А.И. · 7-501 · с 09.11\",\"startsOn\":\"2026-11-09\"},{\"id\":\"24ПИжб-22\",\"weekday\":6,\"period\":3,\"week\":\"both\",\"title\":\"Дискретная математика\",\"details\":\"пр. · Родоманская А.И. · 7-501 · с 09.11\",\"startsOn\":\"2026-11-09\"},{\"id\":\"24ПИжб-23\",\"weekday\":6,\"period\":4,\"week\":\"both\",\"title\":\"ТА и ФЯ\",\"details\":\"пр. · Бесхмельницына З.А. · 7-513 · с 09.11\",\"startsOn\":\"2026-11-09\"}]};\nconst weeks = [{\"start\":\"2026-08-31\",\"end\":\"2026-09-06\",\"kind\":\"upper\"},{\"start\":\"2026-09-07\",\"end\":\"2026-09-13\",\"kind\":\"lower\"},{\"start\":\"2026-09-14\",\"end\":\"2026-09-20\",\"kind\":\"upper\"},{\"start\":\"2026-09-21\",\"end\":\"2026-09-27\",\"kind\":\"lower\"},{\"start\":\"2026-09-28\",\"end\":\"2026-10-04\",\"kind\":\"upper\"},{\"start\":\"2026-10-05\",\"end\":\"2026-10-11\",\"kind\":\"lower\"},{\"start\":\"2026-10-12\",\"end\":\"2026-10-18\",\"kind\":\"upper\"},{\"start\":\"2026-10-19\",\"end\":\"2026-10-25\",\"kind\":\"lower\"},{\"start\":\"2026-10-26\",\"end\":\"2026-11-01\",\"kind\":\"upper\"},{\"start\":\"2026-11-02\",\"end\":\"2026-11-08\",\"kind\":\"lower\"},{\"start\":\"2026-11-09\",\"end\":\"2026-11-15\",\"kind\":\"upper\"},{\"start\":\"2026-11-16\",\"end\":\"2026-11-22\",\"kind\":\"lower\"},{\"start\":\"2026-11-23\",\"end\":\"2026-11-29\",\"kind\":\"upper\"},{\"start\":\"2026-11-30\",\"end\":\"2026-12-06\",\"kind\":\"lower\"},{\"start\":\"2026-12-07\",\"end\":\"2026-12-13\",\"kind\":\"upper\"},{\"start\":\"2026-12-14\",\"end\":\"2026-12-20\",\"kind\":\"lower\"},{\"start\":\"2026-12-21\",\"end\":\"2026-12-27\",\"kind\":\"upper\"},{\"start\":\"2026-12-28\",\"end\":\"2027-01-03\",\"kind\":\"lower\"},{\"start\":\"2027-01-04\",\"end\":\"2027-01-10\",\"kind\":\"upper\"},{\"start\":\"2027-01-11\",\"end\":\"2027-01-17\",\"kind\":\"lower\"},{\"start\":\"2027-01-18\",\"end\":\"2027-01-24\",\"kind\":\"upper\"},{\"start\":\"2027-01-25\",\"end\":\"2027-01-31\",\"kind\":\"lower\"},{\"start\":\"2027-02-01\",\"end\":\"2027-02-07\",\"kind\":\"upper\"},{\"start\":\"2027-02-08\",\"end\":\"2027-02-14\",\"kind\":\"lower\"},{\"start\":\"2027-02-15\",\"end\":\"2027-02-21\",\"kind\":\"upper\"},{\"start\":\"2027-02-22\",\"end\":\"2027-02-28\",\"kind\":\"lower\"},{\"start\":\"2027-03-01\",\"end\":\"2027-03-07\",\"kind\":\"upper\"},{\"start\":\"2027-03-08\",\"end\":\"2027-03-14\",\"kind\":\"lower\"},{\"start\":\"2027-03-15\",\"end\":\"2027-03-21\",\"kind\":\"upper\"},{\"start\":\"2027-03-22\",\"end\":\"2027-03-28\",\"kind\":\"lower\"},{\"start\":\"2027-03-29\",\"end\":\"2027-04-04\",\"kind\":\"upper\"},{\"start\":\"2027-04-05\",\"end\":\"2027-04-11\",\"kind\":\"lower\"},{\"start\":\"2027-04-12\",\"end\":\"2027-04-18\",\"kind\":\"upper\"},{\"start\":\"2027-04-19\",\"end\":\"2027-04-25\",\"kind\":\"lower\"},{\"start\":\"2027-04-26\",\"end\":\"2027-05-02\",\"kind\":\"upper\"},{\"start\":\"2027-05-03\",\"end\":\"2027-05-09\",\"kind\":\"lower\"},{\"start\":\"2027-05-10\",\"end\":\"2027-05-16\",\"kind\":\"upper\"},{\"start\":\"2027-05-17\",\"end\":\"2027-05-23\",\"kind\":\"lower\"},{\"start\":\"2027-05-24\",\"end\":\"2027-05-30\",\"kind\":\"upper\"},{\"start\":\"2027-05-31\",\"end\":\"2027-06-06\",\"kind\":\"lower\"},{\"start\":\"2027-06-07\",\"end\":\"2027-06-13\",\"kind\":\"upper\"},{\"start\":\"2027-06-14\",\"end\":\"2027-06-20\",\"kind\":\"lower\"},{\"start\":\"2027-06-21\",\"end\":\"2027-06-27\",\"kind\":\"upper\"},{\"start\":\"2027-06-28\",\"end\":\"2027-07-04\",\"kind\":\"lower\"},{\"start\":\"2027-07-05\",\"end\":\"2027-07-11\",\"kind\":\"upper\"},{\"start\":\"2027-07-12\",\"end\":\"2027-07-18\",\"kind\":\"lower\"},{\"start\":\"2027-07-19\",\"end\":\"2027-07-25\",\"kind\":\"upper\"},{\"start\":\"2027-07-26\",\"end\":\"2027-08-01\",\"kind\":\"lower\"},{\"start\":\"2027-08-02\",\"end\":\"2027-08-08\",\"kind\":\"upper\"},{\"start\":\"2027-08-09\",\"end\":\"2027-08-15\",\"kind\":\"lower\"},{\"start\":\"2027-08-16\",\"end\":\"2027-08-22\",\"kind\":\"upper\"},{\"start\":\"2027-08-23\",\"end\":\"2027-08-29\",\"kind\":\"lower\"},{\"start\":\"2027-08-30\",\"end\":\"2027-09-05\",\"kind\":\"upper\"}];\nconst siteURL = \"https://mezhdu-parami-fiteu.artisticjuice.chatgpt.site/\";\nfunction shiftDay(date, offset) {\n  return new Date(date.getFullYear(), date.getMonth(), date.getDate() + offset, 12);\n}\n\nfunction displayDay(now) {\n  return shiftDay(now, now.getHours() >= 20 ? 1 : 0);\n}\n\nfunction dateKey(date) {\n  return [date.getFullYear(), date.getMonth() + 1, date.getDate()]\n    .map(value => String(value).padStart(2, \"0\")).join(\"-\");\n}\n\nfunction nextEvening(now) {\n  return new Date(now.getFullYear(), now.getMonth(), now.getDate() + (now.getHours() >= 20 ? 1 : 0), 20);\n}\n\nfunction getDay(weeks, group, date) {\n  const key = dateKey(date);\n  const week = weeks.find(w => w.start <= key && key <= w.end);\n  const weekTitle = week ? (week.kind === \"upper\" ? \"Верхняя неделя\" : \"Нижняя неделя\") : \"\";\n  let message = \"\";\n  if (!week) message = \"На эту дату нет календаря недель\";\n  else if (key < group.validFrom || key > group.validThrough) message = \"На эту дату расписание не загружено\";\n  if (message) return { weekTitle, message, lessons: [] };\n  const weekday = date.getDay() || 7;\n  const matches = group.lessons.filter(l => {\n    if (l.weekday !== weekday || l.startsOn > key || l.endsOn < key) return false;\n    if (l.excludedDates && l.excludedDates.includes(key)) return false;\n    if (l.onlyDates) return l.onlyDates.includes(key);\n    return l.week === \"both\" || l.week === week.kind;\n  });\n  const overrides = new Set(matches.filter(l => l.onlyDates).map(l => l.period));\n  const lessons = matches.filter(l => l.onlyDates || !overrides.has(l.period))\n    .sort((a, b) => a.period - b.period || (a.id < b.id ? -1 : Number(a.id !== b.id)));\n  return { weekTitle, lessons, message: lessons.length ? \"\" : \"Пар нет по расписанию\" };\n}\n\nconst now = new Date();\nconst date = displayDay(now);\nconst day = getDay(weeks, group, date);\nconst widget = new ListWidget();\nwidget.backgroundColor = new Color(\"#173C36\");\nwidget.setPadding(13, 14, 13, 14);\nwidget.refreshAfterDate = nextEvening(now);\nwidget.url = siteURL + \"?group=\" + encodeURIComponent(group.id);\n\nfunction line(value, size, bold, color, limit = 1) {\n  const label = widget.addText(value);\n  label.textColor = new Color(color);\n  label.font = bold ? Font.boldSystemFont(size) : Font.systemFont(size);\n  label.lineLimit = limit;\n  return label;\n}\n\nconst large = config.widgetFamily === \"large\";\nconst small = config.widgetFamily === \"small\";\nconst formatter = new DateFormatter();\nformatter.locale = \"ru_RU\";\nformatter.dateFormat = \"EEE, d MMM\";\nline(group.id + \"  ·  \" + formatter.string(date), small ? 13 : 16, true, \"#FFFFFF\");\nif (day.weekTitle) line(day.weekTitle, 11, false, \"#C9E3BA\");\nwidget.addSpacer(6);\nif (day.message) line(day.message, 14, false, \"#FFFFFF\", 3);\nconst capacity = large ? 6 : small ? 2 : 3;\nfor (const lesson of day.lessons.slice(0, capacity)) {\n  const prefix = lesson.period ? lesson.period + \" · \" : \"\";\n  line(prefix + lesson.title, small ? 12 : 14, true, \"#FFFFFF\");\n  if (large && lesson.details) line(lesson.details, 11, false, \"#DBE7E2\");\n  widget.addSpacer(3);\n}\nif (day.lessons.length > capacity) line(\"Ещё занятий: \" + (day.lessons.length - capacity), 11, false, \"#C9E3BA\");\nif (group.warning && !small) line(\"Есть примечание к расписанию группы\", 10, false, \"#FFDA9F\");\nwidget.addSpacer();\nScript.setWidget(widget);\nif (!config.runsInWidget) await widget.presentMedium();\nScript.complete();\n","icon":{"color":"deep-green","glyph":"calendar-alt"},"share_sheet_inputs":[],"always_run_in_app":false}